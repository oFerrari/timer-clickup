{
  "name": "clickup-timer",
  "version": "1.0.0",
  "description": "Mini painel de bandeja para o time tracking do ClickUp",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "debug": "electron . --debug",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.copasul.clickup-timer",
    "productName": "ClickUp Timer",
    "copyright": "Copasul",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "bubble.html",
      "icon.ico",
      "logo.png",
      "tray-idle.ico",
      "tray-running.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "artifactName": "ClickUp-Timer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClickUp Timer",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "author": {
    "name": "Copasul",
    "email": "andrei.domingos@copasul.coop.br"
  }
}